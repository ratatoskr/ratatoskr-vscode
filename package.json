{
  "name": "ratatoskr-vscode",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/salamander",
    "packages/wraith"
  ],
  "scripts": {
    "test": "npm run test:grammar && npm run test --workspaces",
    "test:grammar": "vscode-tmgrammar-test --config packages/wraith/package.json -g packages/salamander/languages/sal/sal.tmLanguage.json -g packages/wraith/test/js.tmLanguage.json -g packages/wraith/test/lua.tmLanguage.json \"packages/*/test/*/*.test.*\"",
    "package": "npm run package --workspaces"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
